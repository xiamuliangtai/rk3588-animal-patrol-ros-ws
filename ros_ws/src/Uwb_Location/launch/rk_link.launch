<launch>
  <!-- Serial devices -->
  <arg name="uwb_port" default="/dev/uwb_tag" />
  <arg name="uwb_baudrate" default="115200" />
  <arg name="fc_port" default="/dev/fc_link" />
  <arg name="fc_baudrate" default="115200" />

  <!-- ROS topics and rates -->
  <arg name="uwb_topic" default="/uwb/data" />
  <arg name="vision_event_topic"
       default="/vision/detection_event" />
  <arg name="send_rate" default="20.0" />
  <arg name="simulate" default="false" />

  <!-- YOLO and UWB timestamp matching -->
  <arg name="uwb_history_sec" default="5.0" />
  <arg name="vision_uwb_max_delta_ms" default="150.0" />
  <arg name="coordinate_abs_limit_cm" default="1000" />
  <arg name="max_history_samples" default="500" />

  <node pkg="Uwb_Location"
        type="UwbLocation"
        name="uwb_location"
        output="screen"
        respawn="true"
        respawn_delay="2.0">
    <param name="port" value="$(arg uwb_port)" />
    <param name="baudrate" value="$(arg uwb_baudrate)" />
    <param name="simulate" value="$(arg simulate)" />
  </node>

  <node pkg="Uwb_Location"
        type="RKLinkSender"
        name="rk_link_sender"
        output="screen"
        respawn="true"
        respawn_delay="2.0">
    <param name="port" value="$(arg fc_port)" />
    <param name="baudrate" value="$(arg fc_baudrate)" />
    <param name="uwb_topic" value="$(arg uwb_topic)" />
    <param name="vision_event_topic"
           value="$(arg vision_event_topic)" />
    <param name="send_rate" value="$(arg send_rate)" />
    <param name="uwb_history_sec"
           value="$(arg uwb_history_sec)" />
    <param name="vision_uwb_max_delta_ms"
           value="$(arg vision_uwb_max_delta_ms)" />
    <param name="coordinate_abs_limit_cm"
           value="$(arg coordinate_abs_limit_cm)" />
    <param name="max_history_samples"
           value="$(arg max_history_samples)" />
  </node>
</launch>